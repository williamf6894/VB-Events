{
  "info": {
    "name": "VB-Events API",
    "description": "Newman/Postman tests for the VB-Events API. Requires a running backend against freshly seeded data (make seed). Stateful flows are self-restoring.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Login as Alice",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"token returned\", () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "pm.environment.set(\"token\", body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{api}}/auth/login"
          }
        },
        {
          "name": "Login as Bob",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"token returned\", () => pm.expect(body.token).to.be.a('string').and.not.empty);",
                  "pm.environment.set(\"tokenBob\", body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{api}}/auth/login"
          }
        },
        {
          "name": "Capture participant ids",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"seeded with 8 participants\", () => pm.expect(body).to.have.length.greaterThanOrEqual(8));",
                  "const alice = body.find(p => p.email === 'alice@example.com');",
                  "const bob = body.find(p => p.email === 'bob@example.com');",
                  "pm.test(\"alice and bob present\", () => { pm.expect(alice).to.not.be.undefined; pm.expect(bob).to.not.be.undefined; });",
                  "pm.environment.set(\"aliceId\", alice.id);",
                  "pm.environment.set(\"bobId\", bob.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{api}}/participants"
          }
        }
      ]
    },
