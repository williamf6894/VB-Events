{
    "swagger": "2.0",
    "info": {
        "description": "Events management API",
        "title": "VB-Events API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/participants": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "participants"
                ],
                "summary": "List all participants",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Participant"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "object"
                        }
                    }
                }
            },
            "post": {
                "description": "Registers a participant with a name and unique email",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "participants"
                ],
                "summary": "Create a new participant",
                "parameters": [
                    {
                        "description": "Participant to create",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.participantRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.Participant"
                        }
                    },
                    "400": {
                        "description": "Invalid body, or missing name/email",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "409": {
                        "description": "Email already in use",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "object"
                        }
                    }
                }
            }
        },
        "/participants/{id}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "participants"
                ],
                "summary": "Get a participant by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Participant ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Participant"
                        }
                    },
                    "400": {
                        "description": "Invalid participant id",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "404": {
                        "description": "Participant not found",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "object"
                        }
                    }
                }
            },
            "put": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "participants"
                ],
                "summary": "Update a participant",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Participant ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Updated participant data",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.participantRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/models.Participant"
                        }
                    },
                    "400": {
                        "description": "Invalid body or id, or missing name/email",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "404": {
                        "description": "Participant not found",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "409": {
                        "description": "Email already in use",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "object"
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "participants"
                ],
                "summary": "Delete a participant",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Participant ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "400": {
                        "description": "Invalid participant id",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "404": {
                        "description": "Participant not found",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "500": {
                        "description": "Internal error",
                        "schema": {
                            "type": "object"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.participantRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "models.Participant": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        }
    }
}